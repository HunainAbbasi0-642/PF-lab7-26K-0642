#include <stdio.h>
int main() {
    int marks[2][3][3];
    int total[2][3] = {0};
    int i, j, k;
    int topper, overallClass = 0, overallStudent = 0;
    for (i = 0; i < 2; i++) {
        printf("\nClass %d\n", i + 1);
        for (j = 0; j < 3; j++) {
            printf("Student %d:\n", j + 1);
            for (k = 0; k < 3; k++) {
                printf("Enter marks for Subject %d: ", k + 1);
                scanf("%d", &marks[i][j][k]);
            }
        }
    }
    printf("\n--- Total Marks of Students ---\n");
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 3; j++) {
            for (k = 0; k < 3; k++) {
                total[i][j] += marks[i][j][k];
            }
            printf("Class %d, Student %d: %d marks\n",
                   i + 1, j + 1, total[i][j]);
        }
    }
    printf("\n--- Class Toppers ---\n");
    for (i = 0; i < 2; i++) {
        topper = 0;
        for (j = 1; j < 3; j++) {
            if (total[i][j] > total[i][topper]) {
                topper = j;
            }
        }
        printf("Top Performer of Class %d: Student %d with %d marks\n",
               i + 1, topper + 1, total[i][topper]);
    }
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 3; j++) {
            if (total[i][j] >
                total[overallClass][overallStudent]) {
                overallClass = i;
                overallStudent = j;
            }
        }
    }
    printf("\n--- Overall Topper ---\n");
    printf("Overall Topper: Class %d, Student %d with %d marks\n",
           overallClass + 1,
           overallStudent + 1,
           total[overallClass][overallStudent]);
    return 0;
}

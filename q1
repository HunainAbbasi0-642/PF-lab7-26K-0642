#include <stdio.h>
int main() {
    int seats[10][4] = {0};
    int reservations, row, seat;
    int i, j, full, fullyBookedRows = 0;
    printf("Enter number of seats to reserve: ");
    scanf("%d", &reservations);
    while (reservations < 0 || reservations > 40) {
        printf("Invalid number! Enter between 0 and 40: ");
        scanf("%d", &reservations);
    }
    for (i = 0; i < reservations; i++) {
        printf("\nReservation %d\n", i + 1);
        while (1) {
            printf("Enter row number (1-10): ");
            scanf("%d", &row);
            printf("Enter seat number (1-4): ");
            scanf("%d", &seat);
            if (row < 1 || row > 10 ||
                seat < 1 || seat > 4) {
                printf("Invalid row or seat number!\n");
                continue;
            }
            if (seats[row - 1][seat - 1] == 1) {
                printf("Seat already booked\n");
                continue;
            }
            seats[row - 1][seat - 1] = 1;
            printf("Seat reserved successfully!\n");
            break;
        }
    }
    printf("\nSeating Arrangement\n");
    printf("Row\tS1\tS2\tS3\tS4\n");
    for (i = 0; i < 10; i++) {
        printf("%d\t", i + 1);
        for (j = 0; j < 4; j++) {
            printf("%d\t", seats[i][j]);
        }
        printf("\n");
    }
    for (i = 0; i < 10; i++) {
        full = 1;
        for (j = 0; j < 4; j++) {
            if (seats[i][j] == 0) {
                full = 0;
                break;
            }
        }
        if (full == 1) {
            fullyBookedRows++;
            printf("Row %d is fully booked.\n", i + 1);
        }
    }
    printf("\nTotal fully booked rows: %d\n",
           fullyBookedRows);
   return 0;
}
